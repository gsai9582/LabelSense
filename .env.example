# LabelSense Full-Stack Environment Configuration
# ===============================================

# 1. Frontend Configuration (Vite)
VITE_APP_NAME="LabelSense AI"
VITE_APP_VERSION="1.2.0"
VITE_REGULATORY_ENV="DEMO"
VITE_API_BASE_URL="/api"

# 2. Backend Configuration (FastAPI)
APP_NAME="LabelSense Verification Engine"
DEBUG=false
HOST=127.0.0.1
PORT=8000

# 3. Database Configuration (SQLite default; MySQL/PostgreSQL ready)
DATABASE_URL="sqlite:///./labelsense.db"
# DATABASE_URL="mysql+pymysql://user:password@localhost:3306/labelsense"
# DATABASE_URL="postgresql://user:password@localhost:5432/labelsense"

# 4. Security & Cryptography
JWT_SECRET="labelsense_production_secret_key_change_in_production"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=480

# 5. Storage & Processing
UPLOAD_DIR="./uploads"
MAX_UPLOAD_SIZE_MB=10
ALLOWED_MIME_TYPES="application/pdf,image/png,image/jpeg,image/webp,application/json"
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# 6. Assistive AI Layer Configuration
# Options for LLM_PROVIDER: "mock" (offline demo mode, default) or "gemini"
LLM_PROVIDER="mock"
LLM_API_KEY=""
LLM_MODEL="gemini-1.5-flash"
